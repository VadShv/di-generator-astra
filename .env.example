# БД: PostgreSQL (Фаза 1). Сервер поднимается через ./scripts/start-postgres.sh
# Замените имя пользователя/пароль/хост/порт на свои.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/di_generator?schema=public"

# Ключ шифрования для API-ключей ИИ-провайдеров (Фаза 2).
# В проде — через секреты окружения. Должен быть длинной случайной строкой.
AI_PROVIDER_ENCRYPTION_KEY="replace-with-a-long-random-secret"

# Разрешить использование небезопасного dev-ключа шифрования, если AI_PROVIDER_ENCRYPTION_KEY не задан.
# Только для локальной разработки. В production — должен быть unset.
AI_PROVIDER_ALLOW_DEV_KEY=""

# Auth (Phase 5). Set AUTH_SECRET to enable login gate (middleware).
# Generate with: openssl rand -base64 32
# Without AUTH_SECRET the server won't start (fail-closed) unless:
#   - running via `next dev` (NODE_ENV=development), or
#   - ALLOW_OPEN_ACCESS=true is set explicitly (local dev only).
AUTH_SECRET=""

# Explicit opt-in for open access without auth (local dev / CI only).
# Allows running without AUTH_SECRET outside NODE_ENV=development.
# NEVER set to true in production — the server refuses to start regardless.
ALLOW_OPEN_ACCESS=""

# When auth is enabled, create an admin user:
#   bun scripts/create-admin.ts admin@example.com <password> "Admin Name"

# ─────────────────────────────────────────────
# Production deploy (docker-compose) — Фаза 4, шаг 4.3
# ─────────────────────────────────────────────
# Postgres credentials: задаются как секреты, не хардкодятся в compose.
POSTGRES_USER="di_app"
POSTGRES_PASSWORD="replace-with-strong-password"
POSTGRES_DB="di_generator"
# DATABASE_URL для app должен совпадать с creds выше:
# DATABASE_URL="postgresql://di_app:replace-with-strong-password@db:5432/di_generator?schema=public"

# Адрес доверенного reverse-proxy (Caddy) — чтобы getClientIp доверял
# заголовкам x-forwarded-for/x-real-ip. Для docker-compose — имя сервиса.
TRUSTED_PROXY_IP="caddy"

# Домен для HTTPS-сертификата Let's Encrypt (Caddy).
SITE_ADDRESS="di.example.com"
