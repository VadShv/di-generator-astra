# See https://help.github.com/articles/ignoring-files/ for about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config

# logs
*.log
dev.out.log

# temporary / scratch
test
prompt
*.bak

# Skills directory
/skills/

# Database (локальная — не в git)
/db/

# Uploads (загруженные пользователями файлы)
/upload/

# Downloads (runtime)
/download/

# Screenshots — корневые скриншоты, но НЕ ассеты в public/
/*.png
screenshot*.png

# Mini services runtime
/mini-services/*/node_modules/

# Tool results
/tool-results/

# Work artifacts
worklog.md

# AstraCode config
.astracode/

# PostgreSQL portable cluster (данные БД — не в git)
/.pgdata/

# Portable PostgreSQL binaries (распакованные .deb — переживают очистку /tmp)
/vendor/pg-debs/

# Дампы БД (pg_dump — не в git)
/backups/
