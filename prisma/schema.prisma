generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// Юридические лица (Компании)
// Расширено в Фазе 1: ИНН, ОГРН, КПП, юридический/фактический адрес
// ==========================================
model Company {
  id              String       @id @default(cuid())
  name            String       // Название юр. лица
  shortName       String?      // Краткое название
  code            String       @unique // Код/ИНН/КПП
  type            String?      // Тип (ООО, АО, ИП и т.д.)
  inn             String?      // ИНН
  ogrn            String?      // ОГРН
  kpp             String?      // КПП
  legalAddress    String?      // Юридический адрес
  actualAddress   String?      // Фактический адрес
  director        String?      // Руководитель
  description     String?      // Описание
 departments     Department[]
 staffingTables  StaffingTable[]
 uploadedDocuments UploadedDocument[]
  masterPrompts      MasterPrompt[] // Промпты, привязанные к юр. лицу (Фаза 21)
 createdAt       DateTime     @default(now())
 updatedAt       DateTime     @updatedAt

 @@index([inn])
 @@index([name])
}

// ==========================================
// Подразделения (отделы) с иерархией
// ==========================================
model Department {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  parentId       String?
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id])
  positions      Position[]
  staffingTables StaffingTable[]
  masterPrompts  MasterPrompt[]
  trackings      DITracking[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([parentId])
}

// ==========================================
// Справочник — Бизнес-функции
// ==========================================
model BusinessFunction {
  id           String   @id @default(cuid())
  name         String   @unique // Название бизнес-функции
  code         String?  // Код
  description  String?  // Описание
  isActive     Boolean  @default(true)
  positions    Position[]
  masterPrompts MasterPrompt[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// Справочник — Проекты
// ==========================================
model Project {
  id          String   @id @default(cuid())
  name        String   @unique // Название проекта
  code        String?  // Код
  description String?  // Описание
  isActive    Boolean  @default(true)
  positions   Position[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// Штатное расписание (строки ШР)
// Новая модель Фазы 1: связывает должность, подразделение и кол-во ставок
// ==========================================
model StaffingTable {
  id           String   @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  positionTitle String   // Название должности из ШР
  positionCode String?   // Код должности (если есть)
  positionId   String?   // Привязка к созданной Position (после импорта) — обратная связь
  position     Position? @relation("StaffingTablePosition")
  headcount    Int      @default(1) // Кол-во ставок
  category     String?  // Категория (руководители/специалисты/служащие/рабочие)
  source       String   @default("manual") // manual | excel
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([departmentId])
  @@index([positionId])
  @@index([companyId])
}

// ==========================================
// Должности (привязка к ШР)
// ==========================================
model Position {
  id                  String   @id @default(cuid())
  title               String
  code                String   @unique
  departmentId        String
  department          Department  @relation(fields: [departmentId], references: [id])
  grade               String?     // Грейд: "линейная" или "руководитель"
  businessFunctionId  String?     // Бизнес-функция (FK → BusinessFunction)
  businessFunction    BusinessFunction? @relation(fields: [businessFunctionId], references: [id])
  projectId           String?     // Проект (FK → Project)
  project             Project? @relation(fields: [projectId], references: [id])
  headcount           Int      @default(1)
  functions           String?     // Выполняемые функции (JSON строка с массивом)
  staffingTableId     String?  @unique  // Связь со строкой ШР (одна должность ← одна строка ШР)
  staffingTable       StaffingTable? @relation("StaffingTablePosition", fields: [staffingTableId], references: [id])
 archiveDIs          ArchiveDI[]
 generatedDIs        GeneratedDI[]
 uploadedDocuments   UploadedDocument[]
 masterPrompts      MasterPrompt[] // Промпты, привязанные к конкретной должности (Фаза 21)
 trackings          DITracking[] // Отслеживание ДИ по должности (Фаза 22)
 createdAt           DateTime @default(now())
 updatedAt           DateTime @updatedAt

 @@index([departmentId])
 @@index([businessFunctionId])
 @@index([grade])
}

// ==========================================
// Архив должностных инструкций (старые ДИ)
// ==========================================
model ArchiveDI {
  id          String   @id @default(cuid())
  title       String
  content     String   // Полный текст ДИ
  // positionId опционален: архивную ДИ можно загрузить без привязки к должности
  // и привязать позже (см. ТЗ раздел 18).
  positionId  String?
  position    Position?  @relation(fields: [positionId], references: [id])
  // Фаза 23: сгенерированные ДИ, созданные на базе этой архивной ДИ.
  derivedGeneratedDIs GeneratedDI[] @relation("DISourceArchive")
  fileName    String?    // Имя загруженного файла
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([positionId])
  @@index([uploadedAt])
}

// ==========================================
// Загруженные документы (старые ДИ PDF/DOCX)
// Новая модель Фазы 1: распознанный текст, секции, привязка к позиции
// ==========================================
model UploadedDocument {
  id              String   @id @default(cuid())
  fileName        String   // Имя файла
  fileType        String   // pdf | docx
  filePath        String?  // Путь к сохранённому файлу (опц.)
  rawText         String   // Извлечённый текст
  parsedSections  String   @default("[]") // JSON: распознанные секции [{title, content}]
  positionId      String?  // Привязка к должности
  position        Position? @relation(fields: [positionId], references: [id])
  companyId       String?  // Привязка к юр. лицу
  company         Company? @relation(fields: [companyId], references: [id])
  status          String   @default("pending") // pending | parsed | linked | error
  errorMessage    String?  // Ошибка обработки
  uploadedBy      String?  // Кто загрузил
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([positionId])
  @@index([companyId])
  @@index([status])
}

// ==========================================
// Шаблоны должностных инструкций
// ==========================================
model DITemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  sections     DITemplateSection[]
  generatedDIs GeneratedDI[]
  generationJobs GenerationJob[] // Задачи массовой генерации по этому шаблону (Фаза 22)
  isActive     Boolean  @default(true)
  isPrimary    Boolean  @default(false) // Основной шаблон — предвыбран при ручной генерации
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPrimary])
}

model DITemplateSection {
  id             String   @id @default(cuid())
  templateId     String
  template       DITemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title          String
  order          Int      @default(0)
  promptGuidance String?  // Руководство для ИИ при генерации этой секции
  isRequired     Boolean  @default(true)
  content        String?  // Дефолтное содержимое секции
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([templateId])
}

// ==========================================
// Сгенерированные должностные инструкции
// ==========================================
model GeneratedDI {
  id               String   @id @default(cuid())
  positionId       String
  position         Position   @relation(fields: [positionId], references: [id])
  templateId       String?
  template         DITemplate? @relation(fields: [templateId], references: [id])
  // Фаза 23: архивная ДИ, на базе которой сгенерирована эта (референс при генерации).
  sourceArchiveId String?
  sourceArchive   ArchiveDI?  @relation("DISourceArchive", fields: [sourceArchiveId], references: [id], onDelete: SetNull)
  title            String
  status           String   @default("draft") // draft, review, approved, exported, imported
  currentVersion   Int      @default(1)        // Текущая версия ДИ
  signedByEmployee Boolean  @default(false)   // Подписана сотрудником
  signedAt         DateTime?                   // Дата подписания сотрудником
  sections         GeneratedDISection[]
  trackings        DITracking[]
  versions         DIVersion[]
  auditResults     DIAuditResult[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([positionId])
  @@index([status])
  @@index([templateId])
  @@index([sourceArchiveId])
  @@index([createdAt])
}

model GeneratedDISection {
  id             String   @id @default(cuid())
  generatedDIId  String
  generatedDI    GeneratedDI @relation(fields: [generatedDIId], references: [id], onDelete: Cascade)
  sectionTitle   String
  sectionContent String
  order          Int      @default(0)
  aiGenerated    Boolean  @default(true)
  editedBy       String?  // Кто редактировал (user/manual)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([generatedDIId])
}

// ==========================================
// Отслеживание ДИ (жизненный цикл)
// Переименовано из DITracking → Tracking (Фаза 1): привязка к подразделению
// ==========================================
model DITracking {
  id             String   @id @default(cuid())
  generatedDIId  String?  // Сделано опциональным в Фазе 1 (для отчётов по должностям без ДИ)
  generatedDI    GeneratedDI? @relation(fields: [generatedDIId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  positionId     String?
  position       Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  status         String   // sent_for_review | returned_with_comments | approved | rejected | signed | missing | draft | review | outdated
  assignee       String?  // Ответственный
  notes          String?  // Заметки
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([generatedDIId])
}

// ==========================================
// Метки отслеживания (Фаза 32: Журнал действий)
// Накидываются на компанию/подразделение/должность для контроля процесса.
// ==========================================
model TrackingTag {
  id           String   @id @default(cuid())
  // На что навешана метка (одна из сущностей).
  entityType   String   // company | department | position
  entityId     String
  // Заголовок/категория метки (например, «Согласование», «Срочно», «На контроле»).
  label        String
  // Семантика метки: статус процесса или приоритет.
  kind         String   @default("status") // status | priority | watch | milestone
  color        String   @default("amber")  // slate|amber|red|emerald|blue|violet|orange
  assignee     String?  // Ответственный
  dueDate      DateTime? // Дедлайн
  note         String?  // Пояснение
  isResolved   Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  activityLogs ActivityLog[]

  @@index([entityType, entityId])
  @@index([isResolved])
  @@index([assignee])
}

// ==========================================
// Журнал действий — ручные записи (Фаза 32)
// Дополняют виртуальный activity-feed (который агрегирует события из других таблиц).
// ==========================================
model ActivityLog {
  id           String   @id @default(cuid())
  // Тип действия: note | status_change | comment | milestone | reminder
  actionType   String   @default("note")
  // К чему относится запись (опционально — может быть общей заметкой).
  entityType   String?  // company | department | position | di | tag
  entityId     String?
  // Связь с меткой, если запись сделана в контексте метки.
  tagId        String?
  tag          TrackingTag? @relation(fields: [tagId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  author       String?
  // Ссылка на связанную ДИ (если применимо).
  generatedDIId String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([tagId])
  @@index([generatedDIId])
  @@index([createdAt])
}

// ==========================================
// Версии ДИ (для сравнения и истории)
// ==========================================
model DIVersion {
  id                String   @id @default(cuid())
  generatedDIId     String
  generatedDI       GeneratedDI @relation(fields: [generatedDIId], references: [id], onDelete: Cascade)
  content           String   // Полный текст версии (JSON)
  version           Int      @default(1)
  isOriginal        Boolean  @default(false) // true = сгенерированная, false = загруженная после правок
  uploadedBy        String?  // Кто загрузил
  fileName          String?  // Имя файла
  diffSummary       String?  // Краткое резюме различий (ИИ-сгенерированное)
  changeDescription String?  // Описание изменений в данной версии
  createdAt         DateTime @default(now())

  @@index([generatedDIId])
  @@index([createdAt])
}

// ==========================================
// Результаты AI-аудита ДИ
// ==========================================
model DIAuditResult {
  id               String   @id @default(cuid())
  generatedDIId    String
  generatedDI      GeneratedDI @relation(fields: [generatedDIId], references: [id], onDelete: Cascade)
  auditType        String   // Тип аудита: "full", "legal", "consistency"
  overallScore     Int      @default(0) // Общая оценка 0-100
  // 5 категорий правового ядра аудита
  duplicatedTkItems        String   @default("[]") // JSON: дублирование норм ТК РФ
  vagueFormulationItems    String   @default("[]") // JSON: расплывчатые формулировки
  legislativeConflictItems String  @default("[]") // JSON: противоречия законодательству
  unrealisticRequirementItems String @default("[]") // JSON: завышенные/нереалистичные требования
  incompleteSectionItems   String   @default("[]") // JSON: неполнота обязательных разделов
  // Legacy fields (kept for backward compatibility)
  outdatedItems    String   @default("[]") // JSON: массив устаревших пунктов
  contradictoryItems String @default("[]") // JSON: массив противоречивых пунктов
  riskyItems       String   @default("[]") // JSON: массив юридически рискованных пунктов
  recommendations  String   @default("[]") // JSON: массив рекомендаций по улучшению
  summary          String?  // Общее резюме аудита
  auditedBy        String?  // Кто запустил аудит
  createdAt        DateTime @default(now())

  @@index([generatedDIId])
}

// ==========================================
// Мастер-промпты
// Расширено в Фазе 1: категории, переменные, явное версионирование
// ==========================================
model MasterPrompt {
  id                  String   @id @default(cuid())
  name                String
  content             String   // Содержимое промпта (с переменными {{должность}} и т.д.)
  category            String   @default("generation") // generation | audit | improvement | ai_culture
  version             Int      @default(1)
  isActive            Boolean  @default(true)
  isAiCulture         Boolean  @default(false) // Промпт «Культура ИИ» — добавляет раздел про ИИ
  variables           String   @default("[]") // JSON: список переменных промпта
  // Логика применимости
  departmentId        String?  // Применимо к подразделению (null = все)
  department          Department? @relation(fields: [departmentId], references: [id])
  businessFunctionId  String?  // Применимо к бизнес-функции (null = все)
  businessFunction    BusinessFunction? @relation(fields: [businessFunctionId], references: [id])
 grade               String?  // Применимо к грейду (null = все): "линейная" / "руководитель"
 functionType        String?  // Применимо к функции (null = все)
 description         String?  // Описание версии
 // История версий промпта
 versions            MasterPromptVersion[]
  testResults         PromptTestResult[] // Результаты тестирования промпта (Фаза 21)
  generationJobs      GenerationJob[] // Задачи массовой генерации с этим промптом (Фаза 22)
 // Расширенные условия применимости (Фаза 21)
 companyId           String?  // Применимо к юр. лицу (null = все)
  company             Company? @relation(fields: [companyId], references: [id])
  positionId          String?  // Применимо к конкретной должности (null = все)
  position            Position? @relation(fields: [positionId], references: [id])
  // Организация и метрики (Фаза 21)
  tags                String   @default("[]") // JSON-массив тегов
  estimatedTokens     Int?     // Оценка длины промпта в токенах
  useCount            Int      @default(0) // Счётчик применений при генерации
  lastUsedAt          DateTime? // Последнее применение при генерации
 createdAt           DateTime @default(now())
 updatedAt           DateTime @updatedAt

 @@index([category])
 @@index([isActive])
 @@index([name])
  @@index([companyId])
  @@index([positionId])
}

// Новая модель Фазы 1: история версий мастер-промпта
model MasterPromptVersion {
  id              String   @id @default(cuid())
  masterPromptId  String
  masterPrompt    MasterPrompt @relation(fields: [masterPromptId], references: [id], onDelete: Cascade)
 version         Int      // Номер версии
 content         String   // Содержимое промпта на момент версии
 description     String?  // Описание изменений
  diff            String?  // Краткое описание отличий от предыдущей версии (Фаза 21)
 createdBy       String?  // Кто изменил
 createdAt       DateTime @default(now())

 @@index([masterPromptId])
}

// ==========================================
// Цепочки промптов (Фаза 21)
// Последовательность шагов: генерация → улучшение → аудит
// ==========================================
model PromptChain {
  id          String   @id @default(cuid())
  name        String   // Название цепочки
  description String?  // Описание
  steps       String   @default("[]") // JSON: [{category, order, stopOnError}]
  isActive    Boolean  @default(false) // Активная цепочка
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// ==========================================
// Результаты тестирования промптов (Фаза 21)
// ==========================================
model PromptTestResult {
  id              String   @id @default(cuid())
  masterPromptId  String
  masterPrompt    MasterPrompt @relation(fields: [masterPromptId], references: [id], onDelete: Cascade)
  positionId      String?  // Должность, на которой тестировали
  providerId      String?  // Использованный ИИ-провайдер
  response        String   // Ответ модели
  durationMs      Int      // Время генерации (мс)
  rating          Int?     // Оценка пользователя (1–5)
  createdAt       DateTime @default(now())

  @@index([masterPromptId])
  @@index([positionId])
}

// ==========================================
// Коннектор ИИ-моделей (провайдеры)
// Новая модель Фазы 1: универсальный коннектор ИИ (Фаза 2)
// ==========================================
model AIProvider {
  id              String   @id @default(cuid())
  name            String   // Название провайдера
  type            String   // openai_compatible | yandex_cloud | klad | ollama | zai
  baseUrl         String?  // Базовый URL API
  apiKeyEncrypted String?  // Зашифрованный API-ключ
  modelName       String   // Имя модели (gpt-4o, yandexgpt, qwen и т.д.)
  folderId        String?  // folder_id для Yandex Cloud
  isActive        Boolean  @default(false) // Активный провайдер для генерации
  isDefault       Boolean  @default(false) // Провайдер по умолчанию
  config          String   @default("{}") // JSON: доп. настройки (temperature, maxTokens и т.д.)
  lastTestedAt    DateTime? // Последняя проверка соединения
  lastTestStatus  String?  // ok | error
  lastTestMessage String?  // Сообщение теста
  generationJobs  GenerationJob[] // Задачи массовой генерации через этот провайдер (Фаза 22)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

// ==========================================
// Очередь массовой генерации
// Новая модель Фазы 1: задачи массовой генерации с прогрессом (Фаза 6)
// ==========================================
model GenerationJob {
  id              String   @id @default(cuid())
  scope           String   // all | company | department | positions
  scopeData       String   @default("{}") // JSON: {companyId, departmentId, positionIds: []}
  status          String   @default("queued") // queued | running | completed | failed | cancelled
  total           Int      @default(0) // Всего задач
  completed       Int      @default(0) // Выполнено успешно
  failed          Int      @default(0) // Завершилось ошибкой
  results         String   @default("[]") // JSON: [{positionId, status, message, diId}]
  providerId      String?  // Используемый ИИ-провайдер
  provider        AIProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  templateId      String?  // Используемый шаблон
  template        DITemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  masterPromptId  String?  // Используемый мастер-промпт
  masterPrompt    MasterPrompt? @relation(fields: [masterPromptId], references: [id], onDelete: SetNull)
  startedAt       DateTime?
  finishedAt      DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([providerId])
  @@index([masterPromptId])
  @@index([status])
}

// ==========================================
// Users (Phase 5: Auth & production prep)
// Credentials-based auth via next-auth (JWT session strategy).
// Password hash uses Node crypto.scrypt (no extra bcrypt dependency).
// ==========================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  role         String   @default("user") // admin | user
  passwordHash String
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
